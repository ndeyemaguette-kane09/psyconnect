@startuml 01a_use_case_overview
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #EEF7FF
skinparam usecaseBorderColor #2E6DA4
skinparam arrowColor #2E6DA4
skinparam actor {
  BackgroundColor #D6EAF8
  BorderColor #2874A6
}
title Cas d'utilisation — Vue d'ensemble PsyConnect

left to right direction

actor "Patient" as P
actor "Psychologue" as Psy
actor "Administrateur" as Admin

rectangle "PsyConnect" {
  usecase "Gérer son compte\n& profil" as UC_Compte
  usecase "Prendre & gérer\nses rendez-vous" as UC_RDV
  usecase "Effectuer & consulter\nses paiements" as UC_Pay
  usecase "Communiquer\n(messages, notifs)" as UC_Comm
  usecase "Suivre sa santé\n(journal, Xalaat)" as UC_Sante
  usecase "Gérer ses patients\n& consultations" as UC_PsyGest
  usecase "Consulter ses\nrevenus" as UC_Revenue
  usecase "Valider & modérer\nla plateforme" as UC_Admin
  usecase "Envoyer des\nannonces" as UC_Annonces
  usecase "Configurer\nla plateforme" as UC_Config
}

P --> UC_Compte
P --> UC_RDV
P --> UC_Pay
P --> UC_Comm
P --> UC_Sante

Psy --> UC_Compte
Psy --> UC_RDV
Psy --> UC_PsyGest
Psy --> UC_Comm
Psy --> UC_Revenue

Admin --> UC_Admin
Admin --> UC_Annonces
Admin --> UC_Config

@enduml
