@startuml 01b_use_case_patient
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #EEF7FF
skinparam usecaseBorderColor #2E6DA4
skinparam arrowColor #2E6DA4
skinparam actor {
  BackgroundColor #D6EAF8
  BorderColor #2874A6
}
title Cas d'utilisation — Patient

left to right direction

actor "Patient" as P

rectangle "PsyConnect — Espace Patient" {

  package "Authentification" {
    usecase "S'inscrire" as UC_Register
    usecase "Se connecter" as UC_Login
    usecase "Réinitialiser son mot de passe" as UC_Pwd
  }

  package "Profil & Santé" {
    usecase "Compléter / modifier son profil" as UC_Profile
    usecase "Gérer ses antécédents médicaux" as UC_Medical
    usecase "Rédiger son journal intime" as UC_Journal
    usecase "Discuter avec Xalaat (compagnon IA)" as UC_Xalaat
  }

  package "Rendez-vous" {
    usecase "Rechercher un psychologue" as UC_Search
    usecase "Consulter le profil d'un psychologue" as UC_ViewPsy
    usecase "Prendre un rendez-vous" as UC_Book
    usecase "Annuler un rendez-vous" as UC_Cancel
    usecase "Rejoindre la séance en ligne" as UC_Join
  }

  package "Paiement & Solde" {
    usecase "Recharger son solde" as UC_Deposit
    usecase "Payer un rendez-vous" as UC_Pay
    usecase "Consulter l'historique du solde" as UC_Wallet
  }

  package "Communication & Suivi" {
    usecase "Envoyer / recevoir des messages" as UC_Msg
    usecase "Consulter ses notifications" as UC_Notif
    usecase "Consulter les annonces" as UC_Annonces
    usecase "Répondre à un questionnaire (PHQ-9/GAD-7)" as UC_Quest
    usecase "Valider une recommandation post-séance" as UC_Reco
    usecase "Laisser un avis sur un psychologue" as UC_Review
    usecase "Signaler un psychologue" as UC_Report
  }
}

P --> UC_Register
P --> UC_Login
P --> UC_Pwd
P --> UC_Profile
P --> UC_Medical
P --> UC_Journal
P --> UC_Xalaat
P --> UC_Search
P --> UC_ViewPsy
P --> UC_Book
P --> UC_Cancel
P --> UC_Join
P --> UC_Deposit
P --> UC_Pay
P --> UC_Wallet
P --> UC_Msg
P --> UC_Notif
P --> UC_Annonces
P --> UC_Quest
P --> UC_Reco
P --> UC_Review
P --> UC_Report

@enduml
