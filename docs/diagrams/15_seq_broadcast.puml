@startuml 15_seq_broadcast
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBackgroundColor #EEF7FF
skinparam sequenceParticipantBorderColor #2E6DA4
skinparam sequenceLifeLineBorderColor #2E6DA4
skinparam noteBorderColor #F0A500
skinparam noteBackgroundColor #FFF8E1
title Séquence — Annonce groupée (Broadcast admin)

actor "Administrateur" as Admin
actor "Patient / Psychologue" as User
participant "Application Flutter" as App
participant "API Gateway\n:8080" as GW
participant "user-service\n:8082" as UserSvc
participant "notification-service\n:8086" as Notif
database "psyconnect_user" as DB_User
database "psyconnect_notification" as DB_Notif

== Envoi de l'annonce par l'admin ==

Admin -> App : Rédige une annonce\n{titre, message, audience: ALL|PATIENTS|PSYCHOLOGISTS}
App -> GW : POST /admin/notifications/broadcast\n{title, message, audience}
GW -> UserSvc : route /admin/**

UserSvc -> DB_User : Compte les destinataires\n(filtre par rôle selon audience)
UserSvc -> DB_User : INSERT Broadcast\n{title, message, audience, recipientCount, sentAt}
UserSvc --> GW : 202 Accepted\n{sent: N, message: "Annonce en cours d'envoi à N destinataire(s)"}
GW --> App : 202 Accepted
App -> Admin : ✓ Annonce en cours d'envoi

note right of UserSvc
  La persistance est synchrone.
  L'envoi des notifications est
  asynchrone (@Async, fire-and-forget).
  La réponse 202 est renvoyée
  immédiatement.
end note

UserSvc -> UserSvc : [Async] BroadcastService.sendAsync()
loop Pour chaque destinataire
  UserSvc -> Notif : POST /notifications\n{userId=destinataire,\ntitle, message, type=ANNOUNCEMENT}
  Notif -> DB_Notif : INSERT Notification
end

== Consultation des annonces par un utilisateur ==

User -> App : Clique sur l'icône mégaphone\n(dans l'entête de la page d'accueil)
App -> GW : GET /users/broadcasts\nAuthorization: Bearer JWT
GW -> UserSvc : route /users/**
UserSvc -> UserSvc : Extrait le rôle depuis le JWT\n(SecurityContextHolder)
UserSvc -> DB_User : SELECT Broadcast WHERE audience IN\n(ALL + rôle de l'utilisateur)\nORDER BY sentAt DESC
DB_User --> UserSvc : [{Broadcast}]
UserSvc --> App : [{id, title, message, audience,\nrecipientCount, sentAt}]
App -> User : Liste des annonces\navec badge d'audience et date relative

@enduml
