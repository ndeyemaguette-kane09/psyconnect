@startuml 10_seq_rdv
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBackgroundColor #EEF7FF
skinparam sequenceParticipantBorderColor #2E6DA4
skinparam sequenceLifeLineBorderColor #2E6DA4
skinparam noteBorderColor #F0A500
skinparam noteBackgroundColor #FFF8E1
title Séquence — Prise de rendez-vous

actor "Patient" as P
actor "Psychologue" as Psy
participant "Application Flutter" as App
participant "API Gateway\n:8080" as GW
participant "user-service\n:8082" as UserSvc
participant "appointment-service\n:8083" as ApptSvc
participant "notification-service\n:8086" as Notif
database "psyconnect_appointment" as DB_Appt
database "psyconnect_notification" as DB_Notif

== Recherche et sélection d'un psychologue ==

P -> App : Accède à l'onglet Recherche
App -> GW : GET /psychologists?verifiedOnly=true
GW -> UserSvc : liste des psys vérifiés
UserSvc --> App : [{PsychologistProfile}]

P -> App : Sélectionne un psychologue
App -> GW : GET /psychologists/{id}/availabilities
GW -> UserSvc : créneaux hebdomadaires
UserSvc --> App : [{dayOfWeek, startHour, endHour, slotDurationMinutes}]
App -> App : Calcule les créneaux disponibles\nsur les 30 prochains jours

== Réservation ==

P -> App : Choisit un créneau et un type\n(En ligne / Présentiel)
App -> GW : POST /appointments\n{psychologistId, startTime, endTime,\nconsultationType, notes}
GW -> ApptSvc : route /appointments/**
ApptSvc -> DB_Appt : INSERT Appointment{status=PENDING}
ApptSvc -> Notif : POST /notifications\n{userId=patient, title="Demande envoyée",\ntype=APPOINTMENT}
Notif -> DB_Notif : INSERT
ApptSvc -> Notif : POST /notifications\n{userId=psy, title="Nouvelle demande de RDV",\ntype=APPOINTMENT}
Notif -> DB_Notif : INSERT
ApptSvc --> App : 201 Created {Appointment}
App -> P : ✓ Demande envoyée (statut : En attente)

== Traitement par le psychologue ==

Psy -> App : Consulte l'onglet Agenda
App -> GW : GET /appointments/psychologist/{id}
GW -> ApptSvc : liste des RDV
ApptSvc --> App : [{Appointment{status=PENDING}}]

alt Psychologue confirme
  Psy -> App : Accepte le rendez-vous
  App -> GW : PUT /appointments/{id}/status?status=CONFIRMED
  GW -> ApptSvc : mise à jour statut
  ApptSvc -> DB_Appt : UPDATE status=CONFIRMED
  ApptSvc -> Notif : POST /notifications\n{userId=patient,\ntitle="RDV confirmé — vous pouvez procéder au paiement",\ntype=APPOINTMENT}
  Notif -> DB_Notif : INSERT
  ApptSvc --> App : 200 OK
  App -> Psy : ✓ Confirmé

else Psychologue refuse
  Psy -> App : Refuse le rendez-vous
  App -> GW : PUT /appointments/{id}/status?status=REJECTED
  ApptSvc -> DB_Appt : UPDATE status=REJECTED
  ApptSvc -> Notif : POST /notifications\n{userId=patient,\ntitle="RDV refusé", type=APPOINTMENT}
  Notif -> DB_Notif : INSERT
  App -> P : ✗ Refusé — nouvelle recherche possible
end

note right of ApptSvc
  Un scheduler vérifie toutes les heures
  les RDV dont startTime - now() < 1h.
  Si reminderSent=false → envoie une
  notification REMINDER au patient et
  au psy, puis reminderSent=true.
end note

@enduml
