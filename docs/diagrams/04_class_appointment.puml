@startuml 04_class_appointment
skinparam classBackgroundColor #EEF7FF
skinparam classBorderColor #2E6DA4
skinparam arrowColor #2E6DA4
skinparam packageBackgroundColor #F8FBFF
title Diagramme de classes — appointment-service

package "appointment-service" {

  enum AppointmentStatus {
    PENDING
    CONFIRMED
    COMPLETED
    CANCELLED
    REJECTED
  }

  enum ConsultationType {
    ONLINE
    PHYSICAL
  }

  enum QuestionnaireType {
    PHQ9
    GAD7
  }

  enum QuestionnaireStatus {
    SENT
    COMPLETED
  }

  class Appointment {
    - Long id
    - Long patientId
    - Long psychologistId
    - LocalDateTime startTime
    - LocalDateTime endTime
    - AppointmentStatus status
    - ConsultationType consultationType
    - String notes
    - String meetingLink
    - Boolean reminderSent
    - LocalDateTime createdAt
  }

  class Conversation {
    - Long id
    - Long patientId
    - Long psychologistId
    - LocalDateTime lastMessageAt
  }

  class Message {
    - Long id
    - Long conversationId
    - Long senderAuthUserId
    - String content
    - LocalDateTime sentAt
    - LocalDateTime readAt
  }

  class Questionnaire {
    - Long id
    - QuestionnaireType type
    - QuestionnaireStatus status
    - Long psychologistId
    - Long patientId
    - Long appointmentId
    - String answers
    - Integer score
    - LocalDateTime sentAt
    - LocalDateTime completedAt
  }

  class SessionRecommendation {
    - Long id
    - Long appointmentId
    - Long psychologistId
    - Long patientId
    - String content
    - boolean completed
    - LocalDateTime createdAt
  }

  Appointment --> AppointmentStatus
  Appointment --> ConsultationType
  Conversation "1" -- "0..*" Message : contient >
  Questionnaire --> QuestionnaireType
  Questionnaire --> QuestionnaireStatus
  Appointment "1" -- "0..*" SessionRecommendation : génère >
  Appointment "1" -- "0..*" Questionnaire : associé à >
}

note right of Appointment
  patientId et psychologistId
  sont des authUserId (auth-service).
  Pas de FK JPA cross-service.
end note

note right of Questionnaire
  answers : réponses CSV "0,1,2,3,…"
  score calculé automatiquement
  à la soumission (algorithme PHQ-9
  ou GAD-7 selon le type).
end note

note right of Conversation
  Une seule conversation par
  couple (patient, psychologue) —
  contrainte UNIQUE en base.
end note

@enduml
