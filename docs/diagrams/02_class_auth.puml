@startuml 02_class_auth
skinparam classBackgroundColor #EEF7FF
skinparam classBorderColor #2E6DA4
skinparam arrowColor #2E6DA4
skinparam packageBackgroundColor #F8FBFF
title Diagramme de classes — auth-service

package "auth-service" {

  enum Role {
    PATIENT
    PSYCHOLOGIST
    ADMIN
  }

  class User {
    - Long id
    - String email
    - String password
    - Role role
    - String pseudo
    - String firstName
    - String lastName
    - boolean enabled
    + getAuthorities() : Collection
  }

  class PasswordResetCode {
    - Long id
    - Long userId
    - String code
    - LocalDateTime expiresAt
    - boolean used
    + isExpired() : boolean
  }

  class JwtAuthenticationFilter {
    - JwtUtil jwtUtil
    + doFilterInternal(req, res, chain)
  }

  class JwtUtil {
    - String secretKey
    + generateToken(email, role, userId) : String
    + validateToken(token) : boolean
    + extractEmail(token) : String
    + extractRole(token) : String
    + extractUserId(token) : Long
  }

  class AuthController {
    + registerPatient(dto) : ResponseEntity
    + registerPsychologist(dto) : ResponseEntity
    + login(dto) : ResponseEntity
    + me(principal) : ResponseEntity
    + forgotPassword(dto) : ResponseEntity
    + resetPassword(dto) : ResponseEntity
  }

  User "1" -- "0..*" PasswordResetCode : possède >
  User --> Role : a un rôle
  AuthController ..> User : crée / authentifie
  AuthController ..> JwtUtil : génère token
  JwtAuthenticationFilter ..> JwtUtil : valide token
}

note right of User
  Table : users
  Source de vérité pour l'authentification.
  Les profils sont dans user-service.
end note

note right of PasswordResetCode
  Table : password_reset_codes
  Code 6 chiffres, valide 15 min,
  renvoyé en clair uniquement en mode dev.
end note

@enduml
